# ZTE F50 Pro (MU3356 / Unisoc UMS9632) & OpenWrt USB udev rules for Linux hosts
# Install with:
#   sudo cp assets/udev/99-unisoc-f50pro.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# Unisoc / Spreadtrum BROM, boot_diag, autodloader
SUBSYSTEM=="usb", ATTR{idVendor}=="1782", ATTR{idProduct}=="4d00", MODE="0666", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1782", ATTR{idProduct}=="4d03", MODE="0666", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1782", ATTR{idProduct}=="4d01", MODE="0666", GROUP="plugdev", TAG+="uaccess"

# ZTE Android ADB / RNDIS / Diag modes (vendor 19d2)
SUBSYSTEM=="usb", ATTR{idVendor}=="19d2", MODE="0666", GROUP="plugdev", TAG+="uaccess"

# OpenWrt USB Gadget CDC-NCM / RNDIS + ACM (1d6b:0104)
SUBSYSTEM=="usb", ATTR{idVendor}=="1d6b", ATTR{idProduct}=="0104", MODE="0666", GROUP="plugdev", TAG+="uaccess"
